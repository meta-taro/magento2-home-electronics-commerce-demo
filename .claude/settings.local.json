{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(php -v)",
      "Bash(composer --version)",
      "Bash(docker --version)",
      "Bash(docker compose version)"
    ],
    "ask": [
      "Write(**)",
      "Edit(**)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(composer:*)",
      "Bash(bin/magento:*)",
      "Bash(php bin/magento:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/auth.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "enableAllProjectMcpServers": false
}
